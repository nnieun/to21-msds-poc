# deploy/compose/.env 의 견본. 보통은 ./gen-env.sh 가 무작위 비밀번호로 .env를 만든다. .env는 git에 올리지 않는다.

# ── 비밀번호 (gen-env.sh가 채움) ──
HTODB_PG_PASSWORD=          # PostgreSQL 관리 계정 kdb
HTODB_READER_PASSWORD=      # 지식DB 조회 계정 kdb_reader (쓰기 권한 없음)
JUDGE_PG_PASSWORD=          # 판정 쓰기 계정 judge_writer
VLLM_API_KEY=               # 앱 → vLLM 호출 키
WEB_PASSWORD=               # 웹 접속 비밀번호 (아이디 to21)

# ── 모델 서버 (vLLM) ──
# 이미지 태그는 GPU 서버에서 `docker pull`로 한 번 확인한다. 없으면 vllm/vllm-openai 의 존재하는 태그로 바꾼다
VLLM_IMAGE=vllm/vllm-openai:v0.32.0
MODEL=Qwen/Qwen3.6-35B-A3B-FP8
MAX_MODEL_LEN=49152         # 요청 하나의 최대 토큰(입력+출력). 지금까지 가장 긴 호출이 34k
MAX_NUM_SEQS=8              # 동시 처리 수. 앱의 동시 호출 상한(MSDS_MODEL_MAX_INFLIGHT)도 이 값을 따른다
GPU_UTIL=0.92               # vLLM이 쓰는 GPU 메모리 비율(OCR을 안 쓰니 0.92)

# ── 앱 ──
MSDS_SERVICE_MODEL=qwen36_35b_runpod_48g   # backend/configs/models.yaml 태그

# ── 웹 ──
WEB_PORT=8080
